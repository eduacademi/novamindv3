{
  "manifest_version": 3,
  "name": "NovaMind — Akıllı İkinci Beyin",
  "version": "1.1.0",
  "description": "Tek tıkla link, makale ve videoları NovaMind kütüphanenize kaydedin.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NovaMind'a Kaydet"
  }
}
