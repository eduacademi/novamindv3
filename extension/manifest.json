{
  "manifest_version": 3,
  "name": "NovaMind — Akıllı İkinci Beyin",
  "version": "1.0.0",
  "description": "Tek tıkla link, makale ve videoları NovaMind kütüphanenize kaydedin.",
  "permissions": [
    "activeTab",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
