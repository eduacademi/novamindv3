rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow write to user profile but prevent client from mutating subscription plan fields directly
      allow write: if request.auth != null && request.auth.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'isPremium']));

      // Subcollections
      match /subscription/{subDoc} {
        // Read-only for client; updates can only be written by server Firebase Admin SDK
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
