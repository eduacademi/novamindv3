# ---- AI (Gemini) ----
# At least one key is needed for server-side AI. Free/Pro quotas are metered per user.
GEMINI_API_KEY=""
# Optional extra keys, comma separated (round-robin + failover on 429)
GEMINI_API_KEYS=""
# Optional model override (default: gemini-flash-latest)
GEMINI_MODEL=""

# ---- App ----
# Public URL of the app (used for CORS). Example: https://novamind.app
APP_URL=""
# Extra allowed origins, comma separated
ALLOWED_ORIGINS=""

# ---- Firebase Admin (REQUIRED in production) ----
# Service account JSON on one line. Without it, subscriptions & usage quotas live in memory
# and are lost on restart / differ between serverless instances.
FIREBASE_SERVICE_ACCOUNT_KEY=""
# Optional overrides (defaults come from firebase-applet-config.json)
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID=""

# ---- Admin panel ----
# Min. 16 characters. Without it the admin panel is disabled. Open the panel with /?admin
ADMIN_SECRET_KEY=""

# ---- Payments (Shopier) ----
# Without these, a local test checkout is used (disabled in production).
SHOPIER_API_KEY=""
SHOPIER_API_SECRET=""
SHOPIER_WEBSITE_INDEX="1"
# Shopier callback URL to configure in the Shopier panel:
#   https://<your-domain>/api/subscription/webhook/shopier

# ---- Optional: Neo4j knowledge graph ----
NEO4J_URI=""
NEO4J_USER=""
NEO4J_PASSWORD=""
NEO4J_DATABASE=""
